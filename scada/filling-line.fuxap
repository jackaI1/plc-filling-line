  "server": {
    "id": "0",
    "name": "FUXA Server",
    "type": "FuxaServer",
    "property": {}
  },
  "alarms": [
    {
      "name": "FillBlocked",
      "property": {
        "variable": "FillBlocked",
        "variableId": "FillBlocked",
        "variableSrc": "line"
      },
      "high": {
        "enabled": true,
        "min": 1,
        "max": 1,
        "checkdelay": 0.1,
        "timedelay": 0,
        "ackmode": "ackactive",
        "text": "Fill position did not clear. Release the held sensor, then reset.",
        "group": "Filling station",
        "color": "#ffffff",
        "bkcolor": "#a52222"
      }
    }
  ],
  "hmi": {
    "views": [
      {
        "id": "line-overview",
        "name": "Line overview",
        "profile": {
          "width": 1200,
          "height": 900,
          "bkcolor": "#edf1f4"
        },
        "items": {
          "OXC_panel": {
            "id": "OXC_panel",
            "type": "svg-ext-own_ctrl-iframe",
            "name": "Filling line operator",
            "property": {
              "address": "http://127.0.0.1:1881/resources/operator/index.html"
            },
            "label": "HtmlIframe"
          }
        },
        "variables": {},
        "svgcontent": "<svg width=\"1200\" height=\"900\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:html=\"http://www.w3.org/1999/xhtml\"><g id=\"OXC_panel\"><foreignObject x=\"0\" y=\"0\" width=\"1200\" height=\"900\"><html:div id=\"D-OXC_panel\" style=\"width:1200px;height:900px\"/></foreignObject></g></svg>",
        "type": "svg"
      }
    ],
    "layout": {
      "start": "line-overview",
      "autoresize": true,
